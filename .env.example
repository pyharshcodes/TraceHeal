# TraceHeal Production-Ready Environment Variables Template
TRACEHEAL_ENV=development
TRACEHEAL_DEBUG=true
TRACEHEAL_HOST=127.0.0.1
TRACEHEAL_PORT=8000
TRACEHEAL_LOG_LEVEL=INFO

# Database Configuration (Async SQLite with WAL mode default)
TRACEHEAL_DATABASE_URL=sqlite+aiosqlite:///./traceheal.db

# Target Microservices URLs (6-Tier Cluster)
TRACEHEAL_GATEWAY_SERVICE_URL=http://127.0.0.1:8080
TRACEHEAL_ORDER_SERVICE_URL=http://127.0.0.1:8081
TRACEHEAL_PAYMENT_SERVICE_URL=http://127.0.0.1:8082
TRACEHEAL_INVENTORY_SERVICE_URL=http://127.0.0.1:8083
TRACEHEAL_AUTH_SERVICE_URL=http://127.0.0.1:8084
TRACEHEAL_NOTIFICATION_SERVICE_URL=http://127.0.0.1:8085

# Enterprise Security & RBAC
TRACEHEAL_JWT_SECRET_KEY=traceheal-enterprise-sec-key-32bytes-min
TRACEHEAL_AUTH_STRICT_MODE=false

# LLM Providers (Optional - deterministic offline fallback runs 100% reliably)
TRACEHEAL_LLM_PROVIDER=gemini
TRACEHEAL_GEMINI_API_KEY=
TRACEHEAL_GEMINI_MODEL=gemini-2.5-flash
TRACEHEAL_OPENAI_API_KEY=
TRACEHEAL_OPENAI_MODEL=gpt-4o
TRACEHEAL_ANTHROPIC_API_KEY=
TRACEHEAL_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# External Integrations (Optional)
TRACEHEAL_GITHUB_TOKEN=
TRACEHEAL_GITHUB_REPO=org/repo-name
TRACEHEAL_SLACK_WEBHOOK_URL=
TRACEHEAL_SUPABASE_URL=

# Sandboxing and Daemon Automation
TRACEHEAL_DOCKER_SANDBOX_ENABLED=true
TRACEHEAL_AUTO_DETECTOR_ENABLED=true
TRACEHEAL_CONTINUOUS_TRAFFIC_ENABLED=false
